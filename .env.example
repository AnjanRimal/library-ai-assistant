# Required
ANTHROPIC_API_KEY=your-api-key

# Optional (defaults shown)
LIA_MODEL=claude-haiku-4-5-20251001
LIA_MAX_TOKENS=1024
LIA_MAX_STEPS=6
LIA_INPUT_PRICE_PER_MTOK=1.0
LIA_OUTPUT_PRICE_PER_MTOK=5.0

# "local" uses the bundled catalog; "api" uses the Spring Boot library-api
LIA_CATALOG=local
LIA_LIBRARY_API_URL=http://localhost:8080

# "hashing" works offline; "sentence-transformers" needs: pip install -e ".[semantic]"
LIA_EMBEDDER=hashing

LIA_MAX_QUESTION_CHARS=1000
